# Colonnade: one long open hall lined with tall columns. Nowhere to hide
# for long, but plenty to bank shots off. Enemies come from the corners.
#
#   #  wall (wall_height)   =  crate (crate_height)   O  pillar
#   P  player start         E  enemy spawn            .  floor
# One character is `tile` metres; the '#' border is the outer wall.

name          Colonnade
tile          2
wall_height   3.2
crate_height  1.0
pillar_height 7

map
