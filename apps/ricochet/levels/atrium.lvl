# Atrium: rings of walls around a small court, each ring's gaps turned a
# quarter from the last, so everything has to wind its way in to you.
#
#   #  wall (wall_height)   =  crate (crate_height)   O  pillar
#   P  player start         E  enemy spawn            .  floor
# One character is `tile` metres; the '#' border is the outer wall.

name          Atrium
tile          2
wall_height   2.6
crate_height  1.0
pillar_height 6

map
